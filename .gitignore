# Workspace-level ignores (product lives in job-search-system/root/)
# Reference repo clones keep their own git history — never embed them here
references/

# OS junk
.DS_Store
Thumbs.db

# Python (belt & braces; root/ has its own .gitignore)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/

# Generated artifacts OUTSIDE root/ (root/data/* is ignored by root/.gitignore).
# This holds application packages + E2E harness output (personal resume content).
job-search-system/data/
job-search-system/applications/

# E2E harness OUTPUT — every run folder contains the real uploaded resume, the
# tailored resume/cover letter and generated packages (personal content).
# The harness itself (analysis/e2e_user_journey.py) IS versioned; its output is not.
job-search-system/analysis/e2e_runs/

# Chat transcripts exported by the agent client
freebuff-chat-*.md
*freebuff*.txt
