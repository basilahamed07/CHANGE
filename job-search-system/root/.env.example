# =============================================================================
# jobagent — Personal International AI Job Search System (Basil Ahamed H)
# Copy to .env and fill in. NEVER commit .env.
# All vars use the JOBAGENT_ prefix. Everything can also be set from Settings UI.
# =============================================================================

# --- AI provider (Basil's default: OpenRouter — one key, many models) --------
# Configure provider/model from Settings > AI Provider in the UI, or here:
JOBAGENT_OPENROUTER_API_KEY=
JOBAGENT_DEEPSEEK_API_KEY=
# Optional additional providers (keys stored in DB via UI preferred):
# JOBAGENT_ANTHROPIC_API_KEY=
# JOBAGENT_OPENAI_API_KEY=
# JOBAGENT_GOOGLE_API_KEY=

# --- Job source API keys (optional) ------------------------------------------
# JOBAGENT_USAJOBS_API_KEY=
# JOBAGENT_ADZUNA_API_KEY=
# JOBAGENT_ADZUNA_APP_ID=

# --- Contact research providers (M7, optional — chain falls back without them) --
# JOBAGENT_HUNTER_API_KEY=
# JOBAGENT_APOLLO_API_KEY=

# --- Data paths ---------------------------------------------------------------
JOBAGENT_DB_PATH=data/jobagent.db
JOBAGENT_RESUME_PATH=data/resume.txt
JOBAGENT_PROFILE_DIR=data/profile
JOBAGENT_COUNTRIES_DIR=config/countries

# --- Scheduling ----------------------------------------------------------------
JOBAGENT_SCRAPE_INTERVAL_HOURS=6

# --- Salary filters (defaults; per-country YAML overrides these) --------------
JOBAGENT_MIN_SALARY=150000
JOBAGENT_MIN_HOURLY_RATE=95

# --- Feature flags (US-specific + optional tooling; D22) ----------------------
JOBAGENT_ENABLE_SALARY_TOOLS=false
JOBAGENT_ENABLE_CAREER_ADVISOR=false
JOBAGENT_ENABLE_SUCCESS_PREDICTOR=false
JOBAGENT_ENABLE_EXTENSION_AUTOFILL=true
JOBAGENT_ENABLE_LINKEDIN_GUEST=false

# --- Gmail (M9). Draft-only unless BOTH this flag and per-draft approval ------
# OAuth access token used to CREATE DRAFTS in your Gmail (no send method exists).
# Leave empty → outreach falls back to local draft files (provider='local').
# JOBAGENT_GMAIL_TOKEN=
JOBAGENT_ALLOW_SEND=false

# --- Server ---------------------------------------------------------------------
JOBAGENT_HOST=0.0.0.0
JOBAGENT_PORT=8085
