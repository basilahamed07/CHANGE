# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Secrets & credentials — NEVER commit
.env
credentials/
*.pem
client_secret*.json

# Personal data & generated artifacts
# data/* is ignored EXCEPT the M2 evidence templates (data/profile/): they are
# config-like (all-UNVERIFIED claim skeletons, no secrets, no resume text) and
# the system fails closed without them on a fresh clone.
data/*
!data/profile/
!data/profile/**
applications/
*.docx
!templates/*.docx

# Runtime artifacts (auto-generated, never needed in git)
config/countries/.backups/

# Node (extension)
node_modules/

# Misc
.worktrees/
.DS_Store
